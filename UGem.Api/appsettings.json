{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "UGem": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error",
      "Quartz": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "__SET_VIA_ENV__"
  },
  "JwtOptions": {
    "SecretKey": "__SET_VIA_ENV__",
    "Issuer": "__SET_VIA_ENV__",
    "Audience": "__SET_VIA_ENV__",
    "ExpireMinutes": 120,
    "RefreshTokenExpireDays": 30
  },
  "MailOptions": {
    "Mail": "__SET_VIA_ENV__",
    "DisplayName": "__SET_VIA_ENV__",
    "Password": "__SET_VIA_ENV__",
    "Host": "__SET_VIA_ENV__",
    "Port": 587
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3001",
      "localhost:3001",
      "https://u-gem-eight.vercel.app",
      "https://u-gem.vercel.app"
    ]
  },
  "Features": {
